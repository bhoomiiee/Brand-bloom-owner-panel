{
  "name": "store-owner-portal",
  "version": "1.0.0",
  "description": "Multi-tenant e-commerce platform and Store Owner Portal with AI assistant and headless storefronts",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "keywords": [
    "ecommerce",
    "store-owner-portal",
    "multi-tenant",
    "express",
    "react",
    "typescript",
    "mongodb"
  ],
  "author": "Brand Bloom Team",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
